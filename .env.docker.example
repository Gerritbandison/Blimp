# Copy this file to .env.docker and fill in real values before running
# docker compose --env-file .env.docker up

# PostgreSQL password (use a strong random value in production)
POSTGRES_PASSWORD=change_me_to_something_strong

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_64_char_random_string_from_openssl_rand_hex_32

# Optional overrides
# JWT_EXPIRES_IN=8h
# CORS_ORIGIN=https://yourdomain.com
# NODE_ENV=production
