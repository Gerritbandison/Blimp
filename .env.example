# ─── Blimp environment variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in values for your environment.
# All variables must be prefixed with VITE_ to be exposed to client-side code.
# Do NOT store secrets or API keys in these files — they are bundled into
# the public build output.

# Application display name (shown in browser tab and header)
VITE_APP_NAME=Blimp

# Port that the local Blimp Agent Python server listens on.
# Must match the port in agent/blimp_agent.py (default: 51723).
VITE_AGENT_PORT=51723

# Base URL for the backend API.
# Set to http://localhost:3001 when running the backend via docker-compose.
# Leave empty for local-only mode (localStorage, no backend).
VITE_API_BASE_URL=
