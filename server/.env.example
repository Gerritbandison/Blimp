# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://blimp:blimp@localhost:5432/blimp?schema=public"

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="8h"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# ── Microsoft Intune / Azure AD ────────────────────────────────────────────────
# These are stored per-integration in the DB, but can be set here as defaults.
# INTUNE_TENANT_ID=
# INTUNE_CLIENT_ID=
# INTUNE_CLIENT_SECRET=

# ── NinjaOne ───────────────────────────────────────────────────────────────────
# NINJAONE_INSTANCE_URL=app.ninjarmm.com
# NINJAONE_CLIENT_ID=
# NINJAONE_CLIENT_SECRET=
